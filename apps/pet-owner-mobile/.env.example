# Public values: bundled into the app; never place server secrets here.
# Physical device: use the computer's reachable LAN IP or a shared HTTPS API.
# Android emulator example: http://10.0.2.2:8080/api
# iOS simulator example: http://localhost:8080/api
EXPO_PUBLIC_API_BASE_URL=https://api.example.com/api
APP_IDENTIFIER=com.vetalya.petowner
APP_SCHEME=myvetapp
APP_VARIANT=development
