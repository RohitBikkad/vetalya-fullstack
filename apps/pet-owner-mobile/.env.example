# Public values: bundled into the app; never place server secrets here.
# Android emulator: http://10.0.2.2:8080/api
# iOS simulator: http://localhost:8080/api
# Physical devices require a reachable LAN address or HTTPS endpoint.
# Production requires HTTPS. Never place secrets in public Expo variables.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api
APP_IDENTIFIER=com.vetalya.petowner
APP_SCHEME=myvetapp
APP_VARIANT=development
