FROM node:22-bookworm-slim AS web
WORKDIR /source
COPY Vetalaya_frontend/package*.json ./Vetalaya_frontend/
RUN cd Vetalaya_frontend && npm ci --no-audit --no-fund
COPY Vetalaya_frontend ./Vetalaya_frontend
COPY packages ./packages
ARG VITE_GOOGLE_CLIENT_ID
ENV VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID
ENV VITE_API_BASE_URL=/api
RUN cd Vetalaya_frontend && npm run build

FROM eclipse-temurin:21-jdk-jammy AS backend
WORKDIR /source
COPY Vetalya_backend/mvnw ./mvnw
COPY Vetalya_backend/.mvn ./.mvn
COPY Vetalya_backend/pom.xml ./pom.xml
COPY Vetalya_backend/src ./src
# Never package repository development signing credentials into staging.
RUN rm -rf src/main/resources/keys && chmod +x mvnw
COPY --from=web /source/Vetalaya_frontend/dist ./src/main/resources/static
RUN ./mvnw -B package -DskipTests

FROM eclipse-temurin:21-jre-jammy
WORKDIR /app
RUN useradd --system --uid 10001 --create-home vetalya
COPY --from=backend --chown=vetalya:vetalya /source/target/Vetalya-0.0.1-SNAPSHOT.jar ./app.jar
USER vetalya
ENV SPRING_PROFILES_ACTIVE=prod,staging
EXPOSE 8080
ENTRYPOINT ["java","-XX:MaxRAMPercentage=55.0","-XX:+UseContainerSupport","-jar","/app/app.jar"]
