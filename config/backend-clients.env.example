# All clients use this ONE Spring Boot deployment and its existing database.
# Public API origin; no trailing /api here (OpenAPI server base).
API_PUBLIC_URL=https://api.example.com
# Exact WEB origins only, comma-separated; no paths, wildcards or native schemes.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://app.example.com
WEB_REDIRECT_URL=https://app.example.com
# Must match APP_SCHEME in the mobile app config.
MOBILE_REDIRECT_SCHEME=myvetapp
# Provider identifiers: these are public IDs, not client secrets.
GOOGLE_CLIENT_ID=replace-with-web-client-id
GOOGLE_ANDROID_CLIENT_ID=replace-with-android-client-id
GOOGLE_IOS_CLIENT_ID=replace-with-ios-client-id
APPLE_SERVICES_ID=replace-with-apple-web-services-id
APPLE_BUNDLE_ID=com.vetalya.petowner
# Production also needs the existing DB, JWT signing, OAuth and messaging secrets
# supplied privately by the deployment environment. Never copy them to frontend/mobile env files.
