# Copy to local-stack.env (ignored); set your local password before starting PostgreSQL.
DB_URL=jdbc:postgresql://localhost:5432/vetalya
DB_USERNAME=vetalya
DB_PASSWORD=
POSTGRES_PORT=5432
SPRING_PROFILES_ACTIVE=dev,local
APP_SEED_DEMO_DATA=false
# All clients use this API/database. Physical devices require a LAN or HTTPS host.
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://127.0.0.1:8080
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api
APP_IDENTIFIER=com.vetalya.petowner
APP_SCHEME=myvetapp
APP_VARIANT=development
